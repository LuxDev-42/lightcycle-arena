{
  "name": "lightcycle-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Lightcycle Arena — app desktop (Electron) que embrulha o jogo (game.html).",
  "author": "Luiz Victor",
  "main": "electron/main.js",
  "scripts": {
    "electron:start": "electron .",
    "electron:selftest": "LC_SELFTEST=1 electron . --no-sandbox",
    "electron:build": "electron-builder --linux AppImage",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.luizvictor.lightcyclearena",
    "productName": "Lightcycle Arena",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**",
      "game.html",
      "src/**",
      "music/**",
      "fonts/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "executableName": "lightcycle-arena",
      "artifactName": "${productName}.${ext}",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Lightcycle Arena",
          "Comment": "Arena de motos de luz estilo Tron",
          "Categories": "Game;ArcadeGame;",
          "StartupWMClass": "lightcycle-arena"
        }
      }
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName} Setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
